# Environment Variables for ClayMelo 🍄

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=claymelo_super_secret_jwt_key_2026_boutique

# Payment Configuration
# Modes: "sandbox" (for local testing/simulation) | "direct_upi" (sister's UPI ID with UTR verification) | "phonepe_gateway" (merchant API)
PAYMENT_MODE=sandbox

# Direct UPI Settings (Sister's UPI ID - editable in admin dashboard or here)
UPI_ID=sisterclaymelo@upi
UPI_NAME=ClayMelo Boutique

# PhonePe Official Merchant Gateway (Optional - when you obtain PhonePe Merchant credentials)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

# Admin Initial Account
ADMIN_EMAIL=admin@claymelo.com
ADMIN_PASSWORD=ClaymeloAdmin2026!
